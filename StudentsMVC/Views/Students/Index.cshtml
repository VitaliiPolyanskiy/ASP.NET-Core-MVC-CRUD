@model IEnumerable<StudentsMVC.Models.Student>
@{
    ViewData["Title"] = "Список студентів";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-secondary">Список студентів</h2>
    <a asp-action="Create" class="btn btn-success shadow-sm">+ Додати студента</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Surname)</th>
                    <th>@Html.DisplayNameFor(model => model.Age)</th>
                    <th>@Html.DisplayNameFor(model => model.GPA)</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="align-middle">@Html.DisplayFor(modelItem => item.Name)</td>
                    <td class="align-middle">@Html.DisplayFor(modelItem => item.Surname)</td>
                    <td class="align-middle">@Html.DisplayFor(modelItem => item.Age)</td>
                    <td class="align-middle">
                        <span class="badge bg-info text-dark fs-6">@Html.DisplayFor(modelItem => item.GPA)</span>
                    </td>
                    <td class="text-end align-middle">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Деталі</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>